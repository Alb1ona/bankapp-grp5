# =============================================================================
#  Bankapp - eksempel på miljøvariabler  (.env.example)
#  SEC-09: Denne fil må ALDRIG indeholde rigtige passwords eller secrets.
#  Kopiér til .env og udfyld værdierne ved installation.
#  Alle værdier her er placeholders / dokumentationsdata.
# =============================================================================

# -- Applikation --------------------------------------------------------------
APP_NAME=bankapp
APP_ENV=development                 # development | production
APP_SECRET_KEY=CHANGE_ME_random_64_char_secret   # bruges til session/CSRF-signering
BANK_DISPLAY_NAME=Demobank Grp5     # fiktivt banknavn vist i UI (FR-01)
DEMO_BANNER=true                    # vis tydelig demo-markering (FR-01)

# -- Netværk / listeners (API-02) --------------------------------------------
# Kunde- og medarbejder-API kan køre på hver sin port, så interne ruter
# ikke kan proxy'es fra DMZ. Sæt forskellige porte i produktion.
CUSTOMER_API_HOST=0.0.0.0
CUSTOMER_API_PORT=8000
INTERNAL_API_HOST=0.0.0.0
INTERNAL_API_PORT=8001

# CORS: hvilke frontend-origins må kalde API'et (udfyldes ved deployment)
CUSTOMER_FRONTEND_ORIGIN=http://localhost:5173
INTERNAL_FRONTEND_ORIGIN=http://localhost:5174

# -- Database (PostgreSQL, VLAN 60) ------------------------------------------
# DB-06: forbindelsen skal understøtte TLS-verifikation i produktion.
# Udfyldes ved installation - GÆT ALDRIG IP/hostnavn (afsnit 1.1).
DATABASE_URL=postgresql+psycopg://bankapp:CHANGE_ME@localhost:5432/bankapp
DATABASE_SSLMODE=prefer             # prefer (dev) | verify-full (produktion)
DATABASE_SSLROOTCERT=               # sti til CA-cert ved verify-full

# -- Sessioner (SEC-02, SEC-03) ----------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30     # max inaktivitet (SEC-03)
SESSION_COOKIE_SECURE=true          # Secure-flag (sæt false kun ved ren http-lokaltest)
SESSION_COOKIE_SAMESITE=lax

# -- Rate limiting (SEC-04) --------------------------------------------------
LOGIN_RATE_LIMIT_MAX=5              # forsøg pr. vindue
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# -- Overførsler (FR-08) -----------------------------------------------------
TRANSFER_MAX_AMOUNT_DKK=50000.00    # konfigurerbar beløbsgrænse

# -- Active Directory / LDAPS (AD-01..06, SEC-10) ----------------------------
# Udfyldes ved installation. Ingen værdier gættes.
AD_ENABLED=false                    # false = brug testbar LDAP-adapter lokalt
AD_SERVER_URI=ldaps://dc01.bank.local:636
AD_BASE_DN=DC=bank,DC=local
AD_BIND_DN=CN=svc-bankapp,OU=Service,DC=bank,DC=local   # læsebegrænset søgekonto (SEC-10)
AD_BIND_PASSWORD=CHANGE_ME                               # kun i .env, aldrig i kode
AD_USER_SEARCH_FILTER=(sAMAccountName={username})
AD_TLS_CA_CERT=                     # sti til CA-cert for LDAPS-validering (SEC-10)
AD_REVALIDATE_SECONDS=300           # genvalidering hvert 5. min (AD-06)

# Gruppemapping (AD-03, afsnit 2.3) - DN'er udfyldes ved installation.
AD_ACCESS_GROUP=BANK-App-Employees  # overordnet adgangsgruppe
AD_GROUP_SUPPORT=BANK-App-Support
AD_GROUP_LOANS=BANK-App-Loans
AD_GROUP_AUDITORS=BANK-App-Auditors
AD_GROUP_ADMINS=BANK-App-Admins

# -- Logging / Wazuh (afsnit 8) ----------------------------------------------
SECURITY_LOG_PATH=/var/log/bankapp/security.jsonl   # JSON Lines til Wazuh-agent
SECURITY_LOG_TO_STDOUT=true         # LOG-04: skriv også til stdout

# -- API-dokumentation -------------------------------------------------------
EXPOSE_OPENAPI_DOCS=true            # kan slås fra i produktion (afsnit 5)
