[Unit]
Description=Bankapp kunde-API (customer surface)
After=network-online.target
Wants=network-online.target

[Service]
User=bankadmin
WorkingDirectory=/home/bankadmin/bankapp-grp5/backend
Environment=API_SURFACE=customer
ExecStart=/home/bankadmin/bankapp-grp5/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=192.168.90.10
Restart=always

[Install]
WantedBy=multi-user.target
