[Unit]
Description=Bankapp internt medarbejder-API (internal surface)
After=network-online.target
Wants=network-online.target

[Service]
User=bankadmin
WorkingDirectory=/home/bankadmin/bankapp-grp5/backend
Environment=API_SURFACE=internal
# Medarbejderportalen kører over http på det interne net; gælder KUN denne tjeneste
# (miljøvariabler går forud for backend/.env, hvor netbanken beholder true).
Environment=SESSION_COOKIE_SECURE=false
ExecStart=/home/bankadmin/bankapp-grp5/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always

[Install]
WantedBy=multi-user.target
